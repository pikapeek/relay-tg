# ---------------------------------------------------------------------------
# RelayTG configuration
# Copy this file to `.env` (Docker runtime) or configure as Cloudflare secrets.
# `.env` is gitignored — never commit a real BOT_TOKEN.
# ---------------------------------------------------------------------------

# Bot API token (secret). Telegram: @BotFather -> /mybots -> API Token.
BOT_TOKEN=1234567890:REPLACE_WITH_REAL_TOKEN

# Numeric id of the support group (must be a Forum group with topics enabled).
# Get it from a group link like https://t.me/c/<without -100 prefix>/... or the
# "Channel/stats" info of an internal admin bot.
GROUP_ID=-1001234567890

# Comma-separated numeric Telegram user ids with ADMIN role.
ADMIN_IDS=123456789,987654321

# Comma-separated numeric Telegram user ids with OPERATOR role (optional).
OPERATOR_IDS=

# Webhook secret (optional but strongly recommended). If set, /webhook rejects
# requests without the matching X-Telegram-Bot-Api-Secret-Token header. Pair it
# with setWebhook's secret_token parameter (see README, "activate the webhook").
WEBHOOK_SECRET=

# SQLite database path. Docker runtime only (mounted volume under /app/data).
DATABASE_PATH=data/relaytg.db

# Global no-reply auto-hide hard cap (hours). The default hide policy is
# permanent display — only a conversation idle past this cap (7 days) is
# auto-hidden by the sweep (never deleted). Per-conversation `/hide N` can
# only set a *sooner* threshold; `/hide off` (0) and `/hide default` (unset)
# both mean permanent display.
AUTO_HIDE_HOURS=168

# Human-verification (arithmetic challenge) settings.
VERIFY_ATTEMPTS=3
VERIFY_TTL_SECONDS=300

# Anti-spam (all thresholds are configurable, never hardcoded).
SPAM_ENABLED=true
SPAM_RATE_LIMIT_MAX=10
SPAM_RATE_LIMIT_WINDOW_SECONDS=60
SPAM_FLOOD_MAX=30
SPAM_FLOOD_WINDOW_SECONDS=60
SPAM_FLOOD_RESTRICT_SECONDS=300
SPAM_MAX_MESSAGE_LENGTH=4096
SPAM_MAX_MEDIA_SIZE_BYTES=20971520

# Ad-text protection (广告防护): keyword / regex blocklist detection for
# UNVERIFIED users only — a verified human is trusted and never ad-blocked.
# On a match the message is silently forwarded into a dedicated "spam quarantine"
# topic (created lazily); a notice with the matched reason + /unban hint is
# posted inside that topic. An admin can reply to a quarantined copy with
# `/ad restore` to forward it back into the sender's topic (NOT auto-unblock).
AD_ENABLED=true
AD_AUTO_BLOCK=true
# Comma-separated keywords (case-insensitive substring match). Unset = the
# built-in default blacklist (43 words covering 兼职/网赚/引流/博彩/贷款/理财
# spam); explicitly empty = rely on runtime `/ad add` commands only.
AD_KEYWORDS=兼职,网赚,返利,返佣,刷单,刷赞,代购,垫付,日结,日赚,月入,躺赚,稳赚,赚钱,高佣金,宝妈,做任务,薅羊毛,加微信,加V,加QQ,引流,私聊,免费领取,领红包,抽奖,中奖,优惠券,赌博,博彩,菠菜,六合彩,彩票,开奖,出款,跑分,贷款,放款,炒股,荐股,投资,理财,虚拟币
# Comma-separated regex patterns (tested against the whole text). A regex may
# not contain a comma. Leave empty if unused.
AD_PATTERNS=
# Allowlist runs FIRST — a hit clears the message regardless of blocklists or
# the link rule. Keywords: case-insensitive substring match. Patterns: regex
# tested against the whole text (no comma). Both may be empty.
AD_ALLOW_KEYWORDS=
AD_ALLOW_PATTERNS=
# Link-count rule: reject unverified messages containing >= N links (http(s)://
# and t.me / telegram.me handles all count). 0 disables the rule. Runtime
# override: `/ad links <n | off>`.
AD_MAX_LINKS=0

# Telegram adapter retry budget (429 / 5xx / network).
TELEGRAM_RETRIES=3
TELEGRAM_BASE_BACKOFF_MS=500
